# NBA Props Agent — Environment Variables
# Copy this to .env and fill in your values

# Required: The Odds API (free at https://the-odds-api.com)
ODDS_API_KEY=your_key_here

# Optional: Anthropic API for Claude analysis layer
# Without this, reports are data-only (no narrative reasoning)
ANTHROPIC_API_KEY=your_key_here

# Optional: Discord webhook for daily delivery
# Create at: Discord Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Optional: SendGrid for email delivery
SENDGRID_API_KEY=your_key_here
EMAIL_TO=your@email.com

# Database path (default: nba_props.db in project root)
DB_PATH=nba_props.db
